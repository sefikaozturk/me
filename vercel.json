{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/writing/swan-fellows",
      "destination": "/notes/swan-fellows",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(cv-.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
